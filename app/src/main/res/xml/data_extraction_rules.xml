<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+ (backup_rules.xml covers older versions).
   Only the pilot's own data travels: the Room database (profile, logbook, challenges,
   achievements) and the settings. flights.db is re-copied from assets and map renders are
   rebuilt on demand, so neither is included. Room uses WAL, so its -wal/-shm files go too.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="user_data.db" />
        <include domain="database" path="user_data.db-wal" />
        <include domain="database" path="user_data.db-shm" />
        <include domain="sharedpref" path="blocktime_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="user_data.db" />
        <include domain="database" path="user_data.db-wal" />
        <include domain="database" path="user_data.db-shm" />
        <include domain="sharedpref" path="blocktime_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
